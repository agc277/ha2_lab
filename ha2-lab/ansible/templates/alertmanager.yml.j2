global:
  resolve_timeout: 1m

route:
  receiver: discord
  group_by: [alertname, host, server]
  group_wait: 10s
  group_interval: 30s
  repeat_interval: 1h
  routes:
    # 擴展／縮減的觸發訊號送給 Windows 的 autoscale.py（失敗或冷卻中時 2 分鐘後重送）
    - receiver: autoscale
      matchers: ['alertname=~"BackendQueueHigh|BackendIdle"']
      group_wait: 0s
      repeat_interval: 2m
      continue: true
    # 縮減訊號只給 autoscale.py；其餘告警都發 Discord
    - receiver: discord
      matchers: ['alertname!="BackendIdle"']

receivers:
  - name: discord
    discord_configs:
      - webhook_url: "{{ discord_webhook_url }}"
        send_resolved: true
        title: '{% raw %}{{ if eq .Status "firing" }}🔴 告警{{ else }}🟢 已恢復{{ end }}：{{ .CommonLabels.alertname }}{% endraw %}'
        message: |-
          {% raw %}{{ range .Alerts -}}
          • {{ .Annotations.summary }}
          {{ end }}{% endraw %}

  - name: autoscale
    webhook_configs:
      - url: "{{ autoscale_webhook_url }}"
        send_resolved: false
