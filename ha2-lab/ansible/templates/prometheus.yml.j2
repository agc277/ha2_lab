global:
  scrape_interval: 5s
  evaluation_interval: 5s

rule_files:
  - /etc/prometheus/rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

scrape_configs:
  - job_name: node
    static_configs:
{% for h in groups['monitor'] + groups['balancers'] + groups['apps'] + groups['scale'] %}
      - targets: ["{{ hostvars[h].ansible_host }}:9100"]
        labels:
          host: {{ h }}
{% endfor %}

  - job_name: haproxy
    static_configs:
{% for h in groups['balancers'] %}
      - targets: ["{{ hostvars[h].ansible_host }}:8405"]
        labels:
          host: {{ h }}
{% endfor %}
